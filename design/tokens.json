  "font": {
    "record": {
      "family": "Newsreader",
      "fallback": [
        "Noto Serif Devanagari",
        "Noto Serif Kannada",
        "Noto Serif Tamil",
        "Noto Serif Telugu",
        "Noto Serif Bengali",
        "Noto Serif Gujarati",
        "Noto Nastaliq Urdu",
        "Georgia",
        "serif"
      ],
      "weights": [
        400,
        500,
        600,
        700
      ],
      "role": "headlines, titles, quotes (italic 400), hero figures"
    },
    "read": {
      "family": "Anek Latin",
      "fallback": [
        "Anek Devanagari",
        "Anek Kannada",
        "Anek Tamil",
        "Anek Telugu",
        "Anek Bangla",
        "Anek Gujarati",
        "Noto Naskh Arabic",
        "system-ui",
        "sans-serif"
      ],
      "weights": [
        400,
        500,
        600,
        700
      ],
      "role": "everything read or tapped: body, UI, labels, eyebrows"
    },
    "mono": {
      "family": "Geist Mono",
      "fallback": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ],
      "weights": [
        400,
        500,
        600
      ],
      "role": "provenance only: times, counts, [n], outlet codes, tickers, CVE ids"
    }
