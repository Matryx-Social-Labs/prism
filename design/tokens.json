  "shadow": {
    "1": "0 1px 0 rgba(17, 19, 23, 0.06)",
    "2": "0 18px 40px -16px rgba(17, 19, 23, 0.28), 0 2px 6px rgba(17, 19, 23, 0.08)",
    "dark-1": "0 1px 0 rgba(0,0,0,.5)",
    "dark-2": "0 18px 40px -12px rgba(0,0,0,.7), 0 2px 6px rgba(0,0,0,.4)"
  },
  "motion": {
    "micro": {
      "ms": 140,
      "easing": "cubic-bezier(.2, .7, .2, 1)"
    },
    "standard": {
      "ms": 220,
      "easing": "cubic-bezier(.2, .7, .2, 1)"
    },
    "flip": {
      "min_ms": 900,
      "max_ms": 1800,
      "easing": "cubic-bezier(.45, .05, .2, 1)",
      "note": "scan line + re-ink; paced by block height; reduced motion = instant swap"
    }
  },
  "layout": {
    "gutter": [
