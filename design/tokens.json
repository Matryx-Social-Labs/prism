{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Prism — Spectrum",
  "version": "4.0.0",
  "note": "Platform-neutral design tokens. web/src/app/globals.css and the future React Native theme are both generated from this file; edit here, never in a consumer. Colour roles are documented in DESIGN.md.",
  "color": {
    "light": {
      "bg":            { "value": "#F6F3EC", "role": "warm editorial paper" },
      "surface":       { "value": "#FCFBF7", "role": "records, rows, inputs" },
      "sunken":        { "value": "#ECE9E0", "role": "wells, selected neutral controls, skeletons" },
      "elevated":      { "value": "#FFFFFF", "role": "sheets and popovers (with shadow-2)" },
      "ink":           { "value": "#171A18", "role": "carbon headlines, body, primary icons" },
      "ink-2":         { "value": "#4E5550", "role": "secondary text, summaries" },
      "ink-3":         { "value": "#6C746F", "role": "tertiary text, labels, provenance" },
      "line":          { "value": "#DCD8CE", "role": "hairlines and record borders" },
      "line-strong":   { "value": "#BDB8AD", "role": "input borders, dashed provisional rules" },
      "accent":        { "value": "#006B62", "role": "deep teal — links, active nav, verified origin" },
      "accent-fill":   { "value": "#006B62", "role": "primary action fill" },
      "accent-soft":   { "value": "#DCEDE9", "role": "teal tint — selected controls and verified origin" },
      "on-accent":     { "value": "#FFFFFF" },
      "coverage-national":  { "value": "#DC9412", "role": "coverage bar — English national outlets (amber)" },
      "coverage-regional":  { "value": "#E4573D", "role": "coverage bar — Indian-language outlets (red-orange)" },
      "coverage-intl":      { "value": "#0E9FB8", "role": "coverage bar — international outlets (cyan)" },
      "coverage-wire":      { "value": "#68736D", "role": "coverage bar — wire / agency" },
      "lens-markets":       { "value": "#0F9D6A", "role": "Markets lens (green)" },
      "lens-markets-soft":  { "value": "#E3F6EE" },
      "lens-cyber":         { "value": "#2563EB", "role": "Cyber lens (blue)" },
      "lens-cyber-soft":    { "value": "#E6EEFE" },
      "lens-health":        { "value": "#DB2777", "role": "Health lens (rose) — drafted, not served" },
      "lens-health-soft":   { "value": "#FCE7F1" },
      "lens-policy":        { "value": "#B7770D", "role": "Policy lens (amber) — drafted, not served" },
      "lens-policy-soft":   { "value": "#FBF0DC" },
      "status-verified":    { "value": "#15151A", "role": "verified record — ink, never a colour" },
      "status-provisional": { "value": "#6C6F7A", "role": "provisional grouping — dashed, grey" },
      "status-disputed":    { "value": "#B7770D" },
      "status-corrected":   { "value": "#D93A2B" },
      "danger":             { "value": "#D93A2B" },
      "up":                 { "value": "#0F9D6A" },
      "down":               { "value": "#D93A2B" }
    },
    "dark": {
      "bg":            { "value": "#111512" },
      "surface":       { "value": "#181D19" },
      "sunken":        { "value": "#0D110E" },
      "elevated":      { "value": "#202621" },
      "ink":           { "value": "#F1EFE8" },
      "ink-2":         { "value": "#BEC4BE" },
      "ink-3":         { "value": "#929B94" },
      "line":          { "value": "#2C342E" },
      "line-strong":   { "value": "#434D46" },
      "accent":        { "value": "#63C8B8" },
      "accent-fill":   { "value": "#168E81" },
      "accent-soft":   { "value": "#173A34" },
      "on-accent":     { "value": "#FFFFFF" },
      "coverage-national":  { "value": "#C48314" },
      "coverage-regional":  { "value": "#E2573E" },
      "coverage-intl":      { "value": "#1A9DB6" },
      "coverage-wire":      { "value": "#89968E" },
      "lens-markets":       { "value": "#2CC08A" },
      "lens-markets-soft":  { "value": "#12301F" },
      "lens-cyber":         { "value": "#5B8DFF" },
      "lens-cyber-soft":    { "value": "#15213D" },
      "lens-health":        { "value": "#F472B6" },
      "lens-health-soft":   { "value": "#3B1528" },
      "lens-policy":        { "value": "#E0A030" },
      "lens-policy-soft":   { "value": "#332611" },
      "status-verified":    { "value": "#F1F1EE" },
      "status-provisional": { "value": "#8E909A" },
      "status-disputed":    { "value": "#E0A030" },
      "status-corrected":   { "value": "#F26A5B" },
      "danger":             { "value": "#F26A5B" },
      "up":                 { "value": "#2CC08A" },
      "down":               { "value": "#F26A5B" }
    },
    "spectrum": {
      "note": "The mark's own gradient. Used as a gradient ONLY in the mark and the landing's dispersion figure.",
      "stops": ["#EF4444", "#F59E0B", "#06B6D4", "#8B5CF6"]
    }
  },
  "font": {
    "display": { "family": "Libre Baskerville", "fallback": ["Tiro Devanagari Hindi", "Noto Serif Kannada", "Noto Serif Tamil", "Noto Serif Telugu", "Noto Serif Bengali", "Noto Serif Gujarati", "Georgia", "serif"], "weights": [400, 700], "role": "headlines, story titles, section titles, quotes, big counts" },
    "sans":    { "family": "IBM Plex Sans", "fallback": ["Hind", "Hind Siliguri", "Hind Vadodara", "Hind Mysuru", "Hind Madurai", "Hind Guntur", "system-ui", "sans-serif"], "weights": [400, 500, 600, 700], "role": "body, UI, labels, buttons — every script" },
    "mono":    { "family": "JetBrains Mono", "fallback": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "weights": [400, 500], "role": "provenance only: times, counts, tickers, CVE ids, citations" }
  },
  "type": {
    "display-xl": { "font": "display", "size": [40, 56], "line": 1.05, "weight": 700, "tracking": "-0.02em", "role": "landing promise" },
    "display-l":  { "font": "display", "size": [30, 38], "line": 1.12, "weight": 700, "tracking": "-0.015em", "role": "story title" },
    "display-m":  { "font": "display", "size": [24, 28], "line": 1.2,  "weight": 700, "tracking": "-0.01em", "role": "lead row, section titles" },
    "title":      { "font": "display", "size": [19, 20], "line": 1.3,  "weight": 700, "role": "story row headline" },
    "quote":      { "font": "display", "size": [17, 18], "line": 1.5,  "weight": 400, "style": "italic", "role": "verbatim quotes" },
    "body":       { "font": "sans", "size": 16,   "line": 1.6,  "weight": 400 },
    "body-s":     { "font": "sans", "size": 14.5, "line": 1.55, "weight": 400 },
    "ui":         { "font": "sans", "size": 14,   "line": 1.4,  "weight": 500, "role": "buttons, tabs, chips" },
    "label":      { "font": "sans", "size": 12.5, "line": 1.4,  "weight": 500, "role": "section eyebrows, field labels" },
    "mono":       { "font": "mono", "size": 12,   "line": 1.5,  "weight": 400, "tracking": "0.02em" },
    "mono-s":     { "font": "mono", "size": 11,   "line": 1.5,  "weight": 400, "tracking": "0.03em", "role": "the floor" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40, "9": 48, "10": 64 },
  "radius": { "xs": 2, "sm": 3, "md": 4, "lg": 6, "xl": 8, "pill": 9999 },
  "shadow": {
    "1": "0 1px 2px rgba(21,21,26,0.06)",
    "2": "0 8px 24px -8px rgba(21,21,26,0.18), 0 2px 6px rgba(21,21,26,0.06)"
  },
  "motion": {
    "micro": { "ms": 160, "easing": "cubic-bezier(.2,.7,.2,1)" },
    "standard": { "ms": 240, "easing": "cubic-bezier(.2,.7,.2,1)" },
    "flip": { "ms": 500, "note": "scan line + re-ink; reduced motion = instant swap" }
  },
  "layout": {
    "gutter": [16, 24, 32],
    "shell": 1360,
    "reading": 640,
    "rail": 220,
    "evidence": 300,
    "topbar": 60,
    "tabbar": 56,
    "touch": 44
  }
}
