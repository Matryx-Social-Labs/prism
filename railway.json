{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "common/**",
      "ingestion/**",
      "classification/**",
      "enrichment/**",
      "correlation/**",
      "personalization/**",
      "agent/**",
      "api/**",
      "worker/**",
      "db/**",
      "pyproject.toml",
      "uv.lock",
      "Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
