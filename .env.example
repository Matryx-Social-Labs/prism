# ── Core infrastructure ─────────────────────────────────────────────
# Local dev values shown; Railway injects its own via service variables.
DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5432/prism
REDIS_URL=redis://localhost:6379/0

# ── LLM provider (OpenRouter primary; both OpenAI-compatible) ───────
LLM_PROVIDER=openrouter                       # openrouter | ollama
# OpenRouter: one key, many models, no weekly cap. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ollama Cloud fallback (set LLM_PROVIDER=ollama + the *:cloud model ids to use)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

# Per-stage model overrides — OpenRouter ids. CONFIRM current ids on
# https://openrouter.ai/models (free models rotate). Free for high-volume/low-
# stakes stages; cheap-paid (~$0.25-0.32/M) for the content the product sells.
PRISM_MODEL_GATE=google/gemini-3.1-flash-lite  # binary relevance — high volume (cheap+reliable)
PRISM_MODEL_CLASSIFY=google/gemini-3.1-flash-lite
PRISM_MODEL_EXTRACT=google/gemini-3.1-flash-lite
PRISM_MODEL_EXTRACT_LIGHT=google/gemini-3.1-flash-lite
PRISM_MODEL_CORRELATE=z-ai/glm-5.3-flash      # briefs/analysis/digest — bake-off 2026-09-17: matches qwen3.7-plus at 1/4 the price
PRISM_MODEL_AGENT=qwen/qwen3.7-plus           # Ask — user-facing
PRISM_MODEL_JUDGE=google/gemini-3.5-flash     # evals — low volume
PRISM_MODEL_GUARD=google/gemini-3.1-flash-lite  # Ask moderation — cheap+fast
PRISM_MODEL_FALLBACK=z-ai/glm-5.3-flash       # takes over when the primary refuses an article on content policy (Gemini SAFETY/PROHIBITED_CONTENT); empty = fail permanently

# ── Ask guardrail + ingestion switch (cost/safety brakes) ──────────
PRISM_ASK_GUARD_ENABLED=true                  # moderate Ask input before the agent runs
PRISM_INGESTION_ENABLED=true                  # false = stop collectors, idle the LLM pipeline
PRISM_CVE_FEEDS_ENABLED=false                 # NVD/CISA-KEV: off until the Cyber tier
PRISM_INGEST_MAX_ARTICLES=0                   # hard corpus ceiling; 0 = no cap
PRISM_HEADLINE_TIER_THRESHOLD=0               # cross-language headline tier cosine; 0 = off (set from labels)
PRISM_LLM_BUDGET_FLOOR_USD=5                  # stop COLLECTING under this OpenRouter balance; 0 = no floor
PRISM_ENRICH_CONCURRENCY=12                   # LLM calls in flight for enrichment (worker)

# ── Email (magic-link auth) ─────────────────────────────────────────
# Where the emailed magic link points (local frontend for dev; Vercel/domain in prod)
PRISM_WEB_URL=http://localhost:3000
PRISM_EMAIL_PROVIDER=console                  # console (dev, logs link) | resend
RESEND_API_KEY=                               # https://resend.com/api-keys
PRISM_EMAIL_FROM=Prism <onboarding@resend.dev>  # use a verified domain in prod

# ── Embeddings (fastembed, in-process CPU — no key needed) ──────────
PRISM_EMBED_MODEL=intfloat/multilingual-e5-base
PRISM_EMBED_DIM=768

# ── Langfuse (self-hosted on Railway; see docs/DEPLOYMENT.md) ───────
# Keys from Langfuse UI → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Separates local traces from prod in the same Langfuse. Set this ONLY on a local
# dev machine (in your gitignored .env) — leave it UNSET in prod so production
# traces stay "default". Commented out here on purpose: prod deploys from git and
# must not inherit "development" from this template.
# LANGFUSE_TRACING_ENVIRONMENT=development

# ── API ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed by CORS (add your Vercel domain in prod)
CORS_ORIGINS=http://localhost:3000
# Token required by POST /api/v1/admin/* endpoints
PRISM_ADMIN_TOKEN=change-me

# ── Optional source keys ────────────────────────────────────────────
# NVD works without a key at a lower rate limit; request one free at
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Observability -----------------------------------------------------------
# Tracing is OPT-IN and off by default. The self-hosted Langfuse stack cost $70
# in two weeks — more than the LLM spend it was watching — and scales to zero
# after 10 idle minutes, so any background span wakes and bills the whole thing.
# Setting the keys is NOT enough; this flag must also be true.
PRISM_LANGFUSE_ENABLED=false
LANGFUSE_TRACING_ENVIRONMENT=development
# The SDK's 5s default OTLP timeout is too short for a self-hosted Langfuse
# (web -> Redis -> worker -> ClickHouse): batches time out and get dropped.
LANGFUSE_TIMEOUT=30
LANGFUSE_FLUSH_AT=128

# --- Pipeline switches -------------------------------------------------------
# The storyline veto: an hourly LLM pass that prunes over-merged stories.
PRISM_VETO_ENABLED=true
# shadow = always LLM-gate and log the embedding classifier's opinion alongside.
PRISM_GATE_MODE=shadow

# --- Auth / product ----------------------------------------------------------
PRISM_MAGIC_TOKEN_TTL_MIN=15
PRISM_SESSION_TTL_DAYS=30
PRISM_MAGIC_REQUEST_COOLDOWN_S=30
PRISM_FREE_MARKETS_SAMPLES=3

# --- Runtime-only (read via os.environ, NOT in Settings) ---------------------
# These never appear in common/config.py, so they are invisible to anyone
# reading the Settings class. Listed here because that is exactly why they were
# missed. Defaults shown.
# PRISM_SERVICE_ROLE=            # "worker" -> run the worker; else API + migrations
# PRISM_STAGES=                  # comma list; default all
# PRISM_CONSUMER_NAME=worker-1
# PRISM_INGEST_INTERVAL_MINUTES=30
# PRISM_TRENDING_INTERVAL_S=600
# PRISM_PARTITION_INTERVAL_S=900
# PRISM_VETO_INTERVAL_S=3600
# PRISM_REQUIRE_DB=              # 1 -> DB tests FAIL instead of skipping
# LOG_LEVEL=INFO
# LOG_FORMAT=                    # json | console; auto-detects from TTY
# PORT=8000
# REPAIR_DATABASE_URL=           # read-only prod URL for tools/
