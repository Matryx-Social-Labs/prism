# ── Core infrastructure ─────────────────────────────────────────────
# Local dev values shown; Railway injects its own via service variables.
DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5432/prism
REDIS_URL=redis://localhost:6379/0

# ── Ollama Cloud (LLM inference) ────────────────────────────────────
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

# Per-stage model overrides (defaults shown; swap based on Langfuse eval scores)
# Measured July 2026: glm-5.2 extraction ~5s vs qwen3.5:397b ~107s at equal quality.
PRISM_MODEL_GATE=deepseek-v4-flash:cloud
PRISM_MODEL_CLASSIFY=gemma4:31b-cloud
PRISM_MODEL_EXTRACT=glm-5.2:cloud
PRISM_MODEL_CORRELATE=glm-5.2:cloud
PRISM_MODEL_AGENT=gpt-oss:120b-cloud
PRISM_MODEL_JUDGE=qwen3.5:397b-cloud

# ── Embeddings (fastembed, in-process CPU — no key needed) ──────────
PRISM_EMBED_MODEL=BAAI/bge-small-en-v1.5
PRISM_EMBED_DIM=384

# ── Langfuse (self-hosted on Railway; see docs/DEPLOYMENT.md) ───────
# Keys from Langfuse UI → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# ── API ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed by CORS (add your Vercel domain in prod)
CORS_ORIGINS=http://localhost:3000
# Token required by POST /api/v1/admin/* endpoints
PRISM_ADMIN_TOKEN=change-me

# ── Optional source keys ────────────────────────────────────────────
# NVD works without a key at a lower rate limit; request one free at
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
